# Switching between node-modules mode and pnpm mode requires changing how relative paths are handled.

# (pnpm mode) allow modules to resolve correctly in upstream podfiles, comment out for node-modules mode
ENV['REACT_NATIVE_NODE_MODULES_DIR'] = File.join(__dir__, '../node_modules')

# (pnpm mode)
require_relative '../node_modules/react-native-test-app/macos/test_app'
# (node-modules mode)
# require_relative '../../../node_modules/react-native-test-app/macos/test_app'

workspace 'Storybook.xcworkspace'

# (pnpm mode)
react_native_path = "#{__dir__}/../node_modules/react-native"
# (node-modules mode)
# react_native_path = "#{__dir__}/../../../node_modules/react-native"

# react-native-macos runs on JSC (no hermes-engine pod). react-native-reanimated's JSC
# runtime includes <jsc/JSCRuntime.h>, which lives at react-native-macos/ReactCommon/jsc but
# isn't on reanimated's header search paths on macOS. Add ReactCommon so the include resolves.
fix_reanimated_macos = lambda do |installer|
  react_common = File.join(__dir__, '../node_modules/react-native-macos/ReactCommon')
  installer.pods_project.targets.each do |target|
    next unless target.name == 'RNReanimated'
    target.build_configurations.each do |config|
      paths = config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
      paths = [paths] unless paths.is_a?(Array)
      config.build_settings['HEADER_SEARCH_PATHS'] = paths + ["\"#{react_common}\""]
    end
  end
end

use_test_app!(post_install: fix_reanimated_macos) do |target|
  target.app do
    platform :osx, '12'
  end
end
